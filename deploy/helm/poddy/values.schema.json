{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "poddy Helm values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "hostAliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ip",
          "hostnames"
        ],
        "properties": {
          "ip": {
            "type": "string"
          },
          "hostnames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "tokenAdmin": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        }
      }
    },
    "oidc": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "issuer": {
          "type": "string"
        },
        "discoveryUrl": {
          "type": "string"
        },
        "authorizationUrl": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "clientSecret": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "redirectUrl": {
          "type": "string"
        },
        "scopes": {
          "type": "string"
        },
        "allowedGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedUsers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sessionKey": {
          "type": "string"
        },
        "sessionTtl": {
          "type": "string"
        }
      }
    },
    "externalAuth": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "redirectBase": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "keyKey": {
          "type": "string"
        },
        "tokenSecretName": {
          "type": "string"
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "clientId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$"
              },
              "type": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "displayIcon": {
                "type": "string"
              },
              "clientId": {
                "type": "string"
              },
              "clientSecret": {
                "type": "string"
              },
              "existingSecret": {
                "type": "string"
              },
              "clientSecretKey": {
                "type": "string"
              },
              "authUrl": {
                "type": "string"
              },
              "tokenUrl": {
                "type": "string"
              },
              "validateUrl": {
                "type": "string"
              },
              "revokeUrl": {
                "type": "string"
              },
              "redirectUrl": {
                "type": "string"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "regex": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "env": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pkce": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "mesh": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "controlUrl": {
          "type": "string"
        },
        "loginUrl": {
          "type": "string"
        },
        "authKey": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "authKeyKey": {
          "type": "string"
        },
        "clientAuthKey": {
          "type": "string"
        },
        "clientAuthKeyKey": {
          "type": "string"
        },
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "expiration": {
              "type": "string"
            },
            "waitTimeout": {
              "type": "string"
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "caSecret": {
          "type": "string"
        },
        "caKey": {
          "type": "string"
        },
        "stateDir": {
          "type": "string"
        },
        "derpUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "embedded": {
              "type": "boolean"
            },
            "regionId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            },
            "regionCode": {
              "type": "string"
            },
            "regionName": {
              "type": "string"
            },
            "stunPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "ipv4": {
              "type": "string"
            },
            "ipv6": {
              "type": "string"
            },
            "service": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stunNodePort": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              }
            }
          }
        },
        "headscale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string"
            },
            "imagePullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "host": {
              "type": "string"
            },
            "serverUrl": {
              "type": "string"
            },
            "ingressClassName": {
              "type": "string"
            },
            "tlsSecret": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "storage": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "resources": {
              "type": "object"
            },
            "extraEnv": {
              "type": "array"
            },
            "service": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "",
                    "ClusterIP",
                    "NodePort",
                    "LoadBalancer"
                  ]
                },
                "httpNodePort": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "annotations": {
                  "type": "object"
                }
              }
            },
            "nameservers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "searchDomains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "issuer": {
                  "type": "string"
                },
                "clientId": {
                  "type": "string"
                },
                "clientSecret": {
                  "type": "string"
                },
                "existingSecret": {
                  "type": "string"
                },
                "clientSecretKey": {
                  "type": "string"
                },
                "onlyStartIfAvailable": {
                  "type": "boolean"
                },
                "expiry": {
                  "type": "string"
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "allowedDomains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "allowedGroups": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "allowedUsers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "stripEmailDomain": {
                  "type": "boolean"
                }
              }
            },
            "replicas": {
              "type": "integer",
              "minimum": 1
            },
            "storageAccessMode": {
              "enum": [
                "ReadWriteOnce",
                "ReadWriteMany",
                "ReadOnlyMany"
              ]
            },
            "existingClaim": {
              "type": "string"
            },
            "database": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "sqlite",
                    "postgres"
                  ]
                },
                "postgres": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "host": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "name": {
                      "type": "string"
                    },
                    "user": {
                      "type": "string"
                    },
                    "ssl": {
                      "enum": [
                        "disable",
                        "require",
                        "verify-ca",
                        "verify-full"
                      ]
                    },
                    "existingSecret": {
                      "type": "string"
                    },
                    "passwordKey": {
                      "type": "string"
                    },
                    "password": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "dex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string"
            },
            "imagePullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "issuer": {
              "type": "string"
            },
            "users": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "passwordHash": {
                    "type": "string"
                  }
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "ssh": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "addr": {
          "type": "string"
        },
        "publicHost": {
          "type": "string"
        },
        "publicPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "authorizedKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "existingKeysSecret": {
          "type": "string"
        },
        "existingHostKeySecret": {
          "type": "string"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "loadBalancerClass": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "loadBalancerIP": {
              "type": "string"
            },
            "externalTrafficPolicy": {
              "type": "string"
            }
          }
        },
        "allowUnmappedKeys": {
          "type": "boolean"
        },
        "requireAgent": {
          "type": "boolean"
        },
        "agent": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "tokenTtl": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "certTtl": {
          "type": "string"
        },
        "ca": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "keyKey": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        }
      }
    },
    "http": {
      "type": "object",
      "properties": {
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "loadBalancerClass": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "loadBalancerIP": {
              "type": "string"
            },
            "externalTrafficPolicy": {
              "type": "string"
            }
          }
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "configMapName": {
          "type": "string"
        },
        "createConfigMap": {
          "type": "boolean"
        },
        "admins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auditors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "teams": {
          "type": "object"
        },
        "userQuotas": {
          "type": "object"
        },
        "templates": {
          "type": "object"
        },
        "extraRules": {
          "type": "array"
        }
      }
    },
    "dotfiles": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "storageClass": {
          "type": "string"
        },
        "imageRegistry": {
          "type": "string"
        },
        "imageRegistryMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workspaceState": {
      "type": "object",
      "properties": {
        "configMapName": {
          "type": "string"
        }
      }
    },
    "vscodeExtension": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "releaseUrl": {
          "type": "string"
        },
        "downloadUrl": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "hosts": {
          "type": "array"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "urlKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "autoMigrate": {
          "type": "boolean"
        },
        "connectTimeout": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "relabelings": {
              "type": "array"
            },
            "metricRelabelings": {
              "type": "array"
            }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "live": {
          "type": "boolean"
        },
        "history": {
          "type": "boolean"
        },
        "global": {
          "type": "boolean"
        },
        "costs": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "visibleToUsers": {
              "type": "boolean"
            },
            "cpuCoreHour": {
              "type": "number",
              "minimum": 0
            },
            "memoryGBHour": {
              "type": "number",
              "minimum": 0
            },
            "storageGBMonth": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string"
            }
          }
        },
        "prometheus": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "tokenKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "key"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "sshHost": {
            "type": "string"
          },
          "sshPort": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          }
        }
      }
    },
    "regionsExistingSecret": {
      "type": "string"
    },
    "regionsKey": {
      "type": "string"
    },
    "regionManager": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "hubUrl": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "keyKey": {
          "type": "string"
        }
      }
    },
    "desktop": {
      "type": "object",
      "properties": {
        "secret": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "helperImage": {
          "type": "string"
        },
        "s3": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "useSSL": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "accessKeyKey": {
              "type": "string"
            },
            "secretKeyKey": {
              "type": "string"
            },
            "accessKey": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            }
          }
        }
      }
    },
    "minReadySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "portal": {
      "type": "object",
      "properties": {
        "addr": {
          "type": "string"
        },
        "shutdownDrainDelay": {
          "type": "string"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "unhealthyPodEvictionPolicy": {
          "enum": [
            "IfHealthyBudget",
            "AlwaysAllow"
          ]
        }
      }
    }
  }
}
