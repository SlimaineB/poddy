---
import logo from '../assets/logo.svg';

const base = import.meta.env.BASE_URL;
const docs = `${base}getting-started/`;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={base} aria-label="poddy home">
      <img src={logo.src} width="36" height="36" alt="" />
      <span>poddy</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <a href={`${base}#product`}>Product</a>
      <a href={`${base}#how-it-works`}>How it works</a>
      <a href={`${base}#security`}>Security</a>
      <a href={docs}>Docs</a>
    </nav>

    <div class="header-actions">
      <a
        class="icon-link"
        href="https://github.com/SlimaineB/poddy"
        aria-label="poddy on GitHub"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2.2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11 11 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.3 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6a11.5 11.5 0 0 0 7.9-10.9C23.5 5.7 18.3.5 12 .5Z" />
        </svg>
      </a>
      <a class="button button-small" href={docs}>Get started</a>
    </div>
  </div>
</header>
